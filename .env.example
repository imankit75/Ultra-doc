# ============================================================
# Ultra Doc-Intelligence — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.

# HuggingFace token (REQUIRED — Gemma models are gated)
# Get your token: https://huggingface.co/settings/tokens
# Accept license: https://huggingface.co/google/gemma-4-E2B-it
HF_TOKEN=hf_your_token_here

# Force a specific device (optional — auto-detected by default)
# FORCE_DEVICE=cpu
# FORCE_DEVICE=cuda
# FORCE_DEVICE=mps

# Override model selection (optional — auto-selected by default)
# ULTRA_DOC_MODEL=google/gemma-3-1b-it
